#
# rc.local for the Raspberry Pi 5 live system and installer.
#
# The stock installer front end, startbsdinstall, runs "bsdinstall" to
# install.  On this board a plain bsdinstall would repartition the whole
# card, firmware partition included, and leave a system the firmware
# cannot start, so a bsdinstall that runs the board's own installer when
# called without a verb is put first in PATH.  Every other verb goes to the
# real one, and everything else about the menus stays stock.
#

# resolv.conf from DHCP ends up in here, so make sure the directory exists
mkdir -p /tmp/bsdinstall_etc

PATH=/usr/libexec/rpi5/bin:${PATH}
export PATH

/usr/libexec/bsdinstall/startbsdinstall primary
